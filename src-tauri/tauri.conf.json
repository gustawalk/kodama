{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kodama",
  "mainBinaryName": "Kodama",
  "version": "1.2.0",
  "identifier": "com.walk.kodama",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Kodama",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "maximized": true,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEMyMTZGQkM0QTk5Mjk1RTgKUldUb2xaS3B4UHNXd2pLMmVsVy84ejRhMDBDQ2xKMnlEb24wQ1dTdWNneWIxSysyK2ovK1YwUEgK",
      "endpoints": ["https://github.com/gustawalk/kodama/releases/latest/download/updater.json"]
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "windows": { "nsis": { "installerIcon": "icons/icon.ico" } },
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
